<?xml version="1.0" encoding="utf-8"?>
<!-- Nur HTTPS. Eigene CAs (Homelab) werden später gezielt pro Server unterstützt. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
